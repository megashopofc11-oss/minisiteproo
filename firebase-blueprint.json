{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "blocked"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "approvedAt": { "type": "number" },
        "approvedBy": { "type": "string" },
        "rejectedAt": { "type": "number" },
        "blockedAt": { "type": "number" }
      },
      "required": ["uid", "name", "email", "role", "status", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "BioSite project created and owned by a user",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "nome": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["projectId", "userId", "nome", "createdAt", "updatedAt"]
    },
    "Template": {
      "title": "Template",
      "description": "BioSite template imported and curated by administrator",
      "type": "object",
      "properties": {
        "templateId": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "demoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "sourceFileReference": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "disabled"] },
        "version": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "createdBy": { "type": "string" }
      },
      "required": ["templateId", "name", "categoryId", "status", "version", "createdAt"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Collection of curated biosite templates managed by admins and browsed by users"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles and authentication statuses"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Subcollection of biosites owned by a specific approved user"
    }
  }
}
