{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "blocked"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "approvedAt": { "type": "number" },
        "approvedBy": { "type": "string" },
        "rejectedAt": { "type": "number" },
        "blockedAt": { "type": "number" }
      },
      "required": ["uid", "name", "email", "role", "status", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "BioSite project created and owned by a user",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "nome": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["projectId", "userId", "nome", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles and authentication statuses"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Subcollection of biosites owned by a specific approved user"
    }
  }
}
