rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based administrative verification based on secure Firestore user role or token claims
    // NO hardcoded emails or secrets in rules
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function getUserStatus(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.status;
    }

    function isApprovedUser(userId) {
      return isOwner(userId) && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         (getUserStatus(userId) == 'approved' || getUserStatus(userId) == 'aprovado'))
      );
    }

    // Users Collection
    match /users/{userId} {
      // Admins can list and read all user profiles.
      // Regular users can ONLY read their own profile document.
      allow read: if isOwner(userId) || isAdmin();

      // Only the authenticated user can create their own document on registration.
      // Strict rule: MUST be created with role: 'user' and status: 'pending'.
      // Creating an 'admin' role or 'approved' status from the client is strictly forbidden.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        (request.resource.data.status == 'pending' || request.resource.data.status == 'pendente');

      // Update rules:
      // Admins have full rights to approve, reject, block, or unblock any user.
      // Regular users can ONLY update their personal profile info, and CANNOT touch role, status, or any approval audit fields.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'status',
          'approvedAt',
          'approvedBy',
          'rejectedAt',
          'blockedAt',
          'serverApprovedAt',
          'serverRejectedAt',
          'serverBlockedAt'
        ])
      );

      // Deleting a user: only admin
      allow delete: if isAdmin();

      // User's private projects subcollection: users/{userId}/projects/{projectId}
      match /projects/{projectId} {
        // Only approved owner or admin can read
        allow read: if isApprovedUser(userId) || isAdmin();

        // Only approved owner can create, update, or delete their projects
        allow create, update, delete: if isApprovedUser(userId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
